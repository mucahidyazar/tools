# Public site origin used for canonical URLs, sitemap and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://tools.mucahid.dev
# Directory for the SQLite usage counter. Must be a persistent, writable volume in production.
TOOLS_DATA_DIR=./.data
# Optional Google Tag Manager container. When set, it takes precedence over GA_ID.
NEXT_PUBLIC_GTM_ID=
# Optional direct Google Analytics 4 measurement ID (used only when GTM_ID is empty).
NEXT_PUBLIC_GA_ID=
# Optional AdSense publisher and ad slot. IDs are public; keep account/API secrets out of this file.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
# Keep false until the AdSense account is approved and the slot is configured.
NEXT_PUBLIC_ADSENSE_ENABLED=false
